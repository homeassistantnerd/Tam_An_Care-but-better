# Tâm An Care API - Environment Variables Example Template
# Copy this file to .env and fill in real values. DO NOT commit .env to git!

NODE_ENV=development
PORT=3000

# Database Configuration (Direct variable or Docker secret file)
DATABASE_URL=postgresql://taman:change_this_db_password@localhost:5432/taman_care
# DATABASE_URL_FILE=/run/secrets/database_url
POSTGRES_USER=taman
POSTGRES_PASSWORD=change_this_db_password
POSTGRES_DB=taman_care

# JWT Authentication Secret (MUST be at least 32 random characters in Production)
# Generate via: openssl rand -base64 32 (Direct variable or Docker secret file)
JWT_SECRET=change-this-development-secret-with-more-than-32-chars-long
# JWT_SECRET_FILE=/run/secrets/jwt_secret

# Security & CORS Settings (Supports CORS_ALLOWED_ORIGINS or CORS_ORIGIN)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# CORS_ORIGIN=https://tamancare.vn
RATE_LIMIT_PER_MINUTE=600
ENABLE_SWAGGER=false

# Finance & service-contract features are fail-closed: unset = disabled / no role allowed.
# Comma-separated role lists use canonical roles (api/src/security/actor-roles.ts).
# TAMANCARE_FINANCE_READ_ROLES=ADMIN,SUPERVISOR,ACCOUNTANT
# TAMANCARE_FINANCE_CENTERWIDE_READ_ROLES=ADMIN,SUPERVISOR
# TAMANCARE_FINANCE_PAYROLL_READ_ROLES=ADMIN,SUPERVISOR
# TAMANCARE_FINANCE_WRITE_ENABLED=false
# TAMANCARE_FINANCE_WRITE_ROLES=ACCOUNTANT
# TAMANCARE_CONTRACT_READ_ROLES=ADMIN,SUPERVISOR,CARE_MANAGER,ACCOUNTANT
# TAMANCARE_CONTRACT_DRAFT_WRITE_ENABLED=false
# TAMANCARE_CONTRACT_DRAFT_WRITE_ROLES=ADMIN,SUPERVISOR,CARE_MANAGER
# TAMANCARE_CONTRACT_SIGNOFF_ENABLED=false
# TAMANCARE_CONTRACT_SIGNATURE_VERIFY_ROLES=ACCOUNTANT
# TAMANCARE_CONTRACT_APPROVER_ROLES=ADMIN,SUPERVISOR
# TAMANCARE_CONTRACT_ARCHIVE_ROOT=/var/lib/tamancare/contracts

# First Supervisor account (only for `node dist/staff-actors/staff-bootstrap.js` on an empty database)
# TAMANCARE_BOOTSTRAP_PASSWORD=at-least-12-characters

# External API Integrations (Optional / Staging keys)
# SMS_API_KEY=your_sms_gateway_api_key_here
# PAYMENT_GATEWAY_SECRET=your_payment_secret_here
